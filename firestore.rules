rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user has admin role
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.role in ['admin', 'manager', 'analyst'];
    }
    
    // Helper function to check if user is at least analyst
    function isAnalyst() {
      return isAuthenticated() && 
             request.auth.token.role in ['admin', 'analyst', 'manager'];
    }
    
    // Transactions collection
    // CRITICAL: Admins can only READ transactions from client
    // All writes MUST go through Cloud Functions
    match /transactions/{txId} {
      // Admins can read all transactions
      allow read: if isAdmin();
      
      // NO direct writes from client - must use Cloud Functions
      allow write: if false;
    }
    
    // Audit logs collection
    // CRITICAL: Immutable audit trail - no updates or deletes allowed
    match /audit_logs/{logId} {
      // Admins can read audit logs
      allow read: if isAdmin();
      
      // NO writes from client - only Cloud Functions can create
      // NO updates or deletes EVER - audit logs are immutable
      allow write: if false;
    }
    
    // Users collection
    match /users/{userId} {
      // Admins can read user data
      allow read: if isAdmin();
      
      // Users can read their own data
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // NO direct writes from client for fraud flags
      // Cloud Functions handle user updates
      allow write: if false;
    }
    
    // Admin users collection (for role management)
    match /admin_users/{adminId} {
      // Only admins can read admin list
      allow read: if isAdmin();
      
      // NO direct writes - super admin only through Cloud Functions
      allow write: if false;
    }
  }
}